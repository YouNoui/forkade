{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "web",
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/playground(.html)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob:; media-src 'self' data: blob:; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/breaker",
      "destination": "/entries/breaker.html"
    },
    {
      "source": "/demo",
      "destination": "/entries/demo.html"
    },
    {
      "source": "/drift",
      "destination": "/entries/drift.html"
    },
    {
      "source": "/glass",
      "destination": "/entries/glass.html"
    },
    {
      "source": "/match",
      "destination": "/entries/match.html"
    },
    {
      "source": "/prism",
      "destination": "/entries/prism.html"
    },
    {
      "source": "/skyhop",
      "destination": "/entries/skyhop.html"
    },
    {
      "source": "/striker",
      "destination": "/entries/striker.html"
    },
    {
      "source": "/swarm",
      "destination": "/entries/swarm.html"
    },
    {
      "source": "/trail",
      "destination": "/entries/trail.html"
    },
    {
      "source": "/wrecker",
      "destination": "/entries/wrecker.html"
    },
    {
      "source": "/echo3d",
      "destination": "/entries/echo3d.html"
    },
    {
      "source": "/rumble",
      "destination": "/entries/rumble.html"
    },
    {
      "source": "/rampage",
      "destination": "/entries/rampage.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/stats.html",
      "destination": "/admin",
      "permanent": false
    }
  ]
}
